# Dora configuration. Copy to `.env` and edit; every variable is optional.
# Documented on the wiki: https://github.com/Constantin-Hentgen/Dora/wiki/Configuration

# --- Routing -----------------------------------------------------------------
# BRouter HTTP endpoint. docker compose uses its own BRouter container by default.
# The public https://brouter.de/brouter also works but is strictly throttled (it answers HTTP 403 when hammered).
BROUTER_URL=http://brouter:17777/brouter
# Timeout of one BRouter call, and total time budget of one loop request (seconds).
BROUTER_TIMEOUT_S=15
REQUEST_TIMEOUT_S=45

# --- Service -----------------------------------------------------------------
# Generic client name sent to BRouter, Nominatim and tile servers ({version} is replaced). Never put personal data here.
USER_AGENT=dora-routes/{version} (+https://github.com/Constantin-Hentgen/Dora)
LOG_LEVEL=INFO

# --- BRouter segments (dora-segments) -------------------------------------
# Area to download, as min_lon,min_lat,max_lon,max_lat. Default: mainland France + Corsica (9 tiles, ~1.5 GB).
SEGMENTS_BBOX=-4.8,41.3,9.6,51.1
SEGMENTS_BASE_URL=https://brouter.de/brouter/segments4/
# Where tiles are written. The Docker image sets /segments4 (the shared volume).
# SEGMENTS_DIR=./segments4

# --- docker compose only -------------------------------------------------------
# DORA_PORT=8000
# DORA_IMAGE=ghcr.io/constantin-hentgen/dora:latest
# BROUTER_IMAGE=ghcr.io/abrensch/brouter:v1.7.8
# BROUTER_MAXTHREADS=4
# BROUTER_JAVA_OPTS=-Xmx1024M -Xms128M -Xmn8M -DmaxRunningTime=60 -DuseRFCMimeType=false -DusePOSTRequests=false
